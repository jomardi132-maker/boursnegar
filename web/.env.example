NODE_ENV=development
PORT=3000
PYTHON_API_BASE=http://127.0.0.1:8001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=boursnegar_db
DB_USER=boursnegar
# DB_PASSWORD is required and must be supplied outside Git
KAVENEGAR_OTP_TEMPLATE=boursnegarotp
# KAVENEGAR_API_KEY is required in production
# AUTH_SESSION_SECRET is required in production
# OTP_PEPPER is required in production
# ADMIN_API_KEY is required for controlled bootstrap operations
OTP_GATEWAY=mock
UPLOAD_DIR=./uploads
