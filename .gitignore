**/.env
**/.env.*
!**/.env.example
**/node_modules/
**/dist/
**/venv/
**/__pycache__/
**/*.pyc
**/*.log
.runtime/
.codex/

# Local databases and runtime data
db.json
*.db
*.sqlite
*.sqlite3

# Backups and dumps
*.dump
*.backup
*.bak
backups/

# User receipts
receipts/
*receipt*.pdf
*receipt*.jpg
*receipt*.jpeg
*receipt*.png
*receipt*.webp

uploads/
coverage/

# Provenanced ingestion artifacts stay local and are imported explicitly.
artifacts/*
!artifacts/.gitkeep
data-service/artifacts/*
!data-service/artifacts/.gitkeep
.chrome-codal-profile/
.venv-codalpy/
