[Unit]
Description=Prune obsolete Boursnegar PostgreSQL dumps using the approved retention policy
After=postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/boursnegar-backup-retention --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups/boursnegar /var/lock
TimeoutStartSec=30min
