[Unit]
Description=Boursnegar local-artifact Codalpy importer (no Codal network access)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/boursnegar-data-current
EnvironmentFile=/var/www/boursnegar-data-current/.env
Environment=PYTHONPATH=.
ExecStart=/var/www/boursnegar-data-current/venv/bin/python scripts/codalpy_remote_import.py --manifest /var/lib/boursnegar/codalpy/manifest.json --symbol * --batch-size 500
TimeoutStartSec=6h
Nice=10
