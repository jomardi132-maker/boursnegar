[Unit]
Description=Retired direct Codal backfill (local-fetch/remote-import replaces this unit)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/boursnegar-data-current
EnvironmentFile=/var/www/boursnegar-data-current/.env
Environment=PYTHONPATH=.
Environment=CODAL_RATE_LIMIT_SECONDS=2.5
ExecStart=/usr/bin/true
TimeoutStartSec=12h
Nice=10
